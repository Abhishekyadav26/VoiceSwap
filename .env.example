# Secret — server only. Enables Groq intent parsing (https://console.groq.com).
# Without it, VoiceSwap uses a built-in heuristic parser (demo still works).
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b (llama-3.3-70b-versatile was retired by Groq in Aug 2026).
GROQ_MODEL=openai/gpt-oss-120b

# Secret — server only. Higher Jupiter rate limits via api.jup.ag (https://portal.jup.ag).
# Without it, VoiceSwap uses the keyless lite-api (fine for low volume).
JUPITER_API_KEY=

# Solana network: mainnet-beta (real Jupiter swaps) or devnet (safe testing —
# balances, parsing and airdrops work; Jupiter quotes are mainnet-only so
# devnet previews carry no price and cannot be sent).
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC for the network above. Use a dedicated endpoint
# (e.g. https://www.helius.dev, Alchemy, or QuickNode) — the public
# mainnet endpoint 403s browser traffic.
# Devnet:  https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Max input amount (UI units) allowed per swap. Safety check blocks above this.
NEXT_PUBLIC_MAX_SWAP_AMOUNT=1000
